cat > .gitignore << 'EOF'
# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables / secrets
.env
backend/.env
frontend/.env
*.env.local

# OS files
.DS_Store

# Logs
*.log
npm-debug.log*

# Build output
frontend/dist/
frontend/build/

# Editor
.vscode/
.idea/
EOF